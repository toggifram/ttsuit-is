NEXT_PUBLIC_SITE_URL=https://ttsuit.is
# Public lock screen. true/1/on shows “Við erum að uppfæra síðuna”.
MAINTENANCE_MODE=
# Optional. Open /opna?kodi=THIS to preview the live site while locked.
MAINTENANCE_BYPASS=
# Google Analytics 4 measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
SHOPIFY_STORE_DOMAIN=tje-tje.myshopify.com
# Dev Dashboard app (Client ID + secret). Tokens are fetched automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional fallback if you still have a legacy Admin token
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_PUBLIC_CHECKOUT=
