MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
SHOPIFY_STORE_DOMAIN=tje-tje.myshopify.com
# Admin API token — reads products while the Online Store stays password-protected
SHOPIFY_ADMIN_ACCESS_TOKEN=
